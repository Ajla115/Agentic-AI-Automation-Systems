    {
      "parameters": {
        "jsCode": "\n// Get input data\nconst inputData = $input.first().json;\n\n// Calculate response time\nlet responseTime = 'N/A';\ntry {\n  const startTime = $('Code in JavaScript').first().json.startTime;\n  if (startTime) {\n    const endTime = Date.now();\n    const duration = endTime - startTime;\n    responseTime = `${duration}ms`;\n  }\n} catch (e) {\n  try {\n    const pageIndexTime = $('PageIndex Query').first().json?.executionTime;\n    if (pageIndexTime) {\n      responseTime = `${pageIndexTime}ms (API only)`;\n    }\n  } catch (err) {}\n}\n\nlet timestamp = new Date().toISOString();\nlet query = 'N/A';\nlet status = 'unknown';\nlet response = 'N/A';\nlet errorMessage = '';\n\nif (inputData.error === true) {\n  status = 'error';\n  errorMessage = inputData.message || 'Unknown error';\n  query = inputData.query || 'N/A';\n  response = 'N/A';\n} else {\n  status = 'success';\n  query = inputData.query || 'N/A';\n  response = inputData.answer || inputData.response || 'No response';\n  errorMessage = '';\n}\n\nreturn [{\n  json: {\n    timestamp: timestamp,\n    query: query,\n    status: status,\n    response: response,\n    errorMessage: errorMessage,\n    responseTime: responseTime\n  }\n}];\n"
      },
