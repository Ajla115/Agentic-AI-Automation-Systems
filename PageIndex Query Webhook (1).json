      "parameters": {
        "jsCode": "// Capture start time\nconst startTime = Date.now();\n\n// Get incoming request body\nconst body = $input.first().json.body || {};\nconst query = body.query;\n\n// Validation checks\nif (!query || query.trim() === '') {\n  return [{\n    json: {\n      error: true,\n      status: 400,\n      message: \"Bad Request: 'query' field is required and cannot be empty\",\n      startTime: startTime\n    }\n  }];\n}\n\n// Valid input - pass through\nreturn [{\n  json: {\n    error: false,\n    query: query.trim()\n  }\n}];"
      },
