    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst docs = Array.isArray(response) ? response : (response.docs || response.data || response.documents || []);\nconst docIds = docs.map(d => d.id || d.doc_id).filter(Boolean);\nconst query = $('Code in JavaScript').item.json.query;\nreturn [{ json: { docIds, query } }];"
      },
      "id": "build-doc-id-array",
      "name": "Build Doc ID Array",
