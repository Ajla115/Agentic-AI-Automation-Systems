    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst text = msg.message?.text || '';\nconst chatId = msg.message?.chat?.id || '';\n\n// Extract Google Drive file ID from various link formats\nconst patterns = [\n  /drive\\.google\\.com\\/file\\/d\\/([a-zA-Z0-9_-]+)/,\n  /drive\\.google\\.com\\/open\\?id=([a-zA-Z0-9_-]+)/,\n  /id=([a-zA-Z0-9_-]+)/\n];\n\nlet fileId = null;\nfor (const p of patterns) {\n  const match = text.match(p);\n  if (match) { fileId = match[1]; break; }\n}\n\nif (!fileId) {\n  return [{ json: { valid: false, chatId, error: 'No Google Drive link found in message. Please send a link like: https://drive.google.com/file/d/FILE_ID/view' } }];\n}\n\nconst directUrl = `https://drive.google.com/uc?export=download&id=${fileId}`;\n\nreturn [{ json: { valid: true, chatId, fileId, directUrl, originalText: text } }];"
      },
      "id": "extract-link-001",
      "name": "Extract Drive Link & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        0
      ]
    },
