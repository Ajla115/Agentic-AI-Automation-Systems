    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst docs = Array.isArray(response) ? response : (response.docs || response.data || response.documents || []);\n\n// Find the old Human_Cases_Consolidated document\nconst oldDoc = docs.find(d => {\n  const name = d.name || d.doc_name || '';\n  return name.toLowerCase().includes('human_cases_consolidated');\n});\n\nconst prev = $('Extract Drive Link & Validate').item.json;\n\nreturn [{\n  json: {\n    oldDocName: oldDoc ? (oldDoc.name || oldDoc.doc_name) : null,\n    oldDocId: oldDoc ? (oldDoc.id || oldDoc.doc_id) : null,\n    hasOldDoc: !!oldDoc,\n    directUrl: prev.directUrl,\n    chatId: prev.chatId,\n    fileId: prev.fileId\n  }\n}];"
      },
