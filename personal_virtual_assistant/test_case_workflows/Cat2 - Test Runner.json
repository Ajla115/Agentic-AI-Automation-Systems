    {
      "parameters": {
        "jsCode": "const payload = $('Collect Before IDs').first().json;\nconst before = payload.calendar_before_ids || [];\nconst beforeSet = new Set(before);\nconst after = $input.all().map(i => i.json);\nconst newEvents = after.filter(e => e.id && !beforeSet.has(e.id));\n// Also pull AI response from Execute Workflow output\nconst vaResp = $('Call Telegram VA').first()?.json || {};\nconst aiOutput = vaResp.ai_output || vaResp.output || '';\nlet eventId = '';\nlet day = '';\nlet startISO = '';\nlet endISO = '';\nlet title = '';\nif (newEvents.length > 0) {\n  const ev = newEvents[0];\n  eventId = ev.id || '';\n  title = ev.summary || '';\n  startISO = (ev.start && (ev.start.dateTime || ev.start.date)) || '';\n  endISO = (ev.end && (ev.end.dateTime || ev.end.date)) || '';\n  if (startISO) {\n    const d = new Date(startISO);\n    day = d.toLocaleDateString('en-US', { weekday: 'long', timeZone: 'Europe/Sarajevo' });\n  }\n}\nconst startedAt = payload.started_at;\nconst elapsedMs = startedAt ? (Date.now() - new Date(startedAt).getTime()) : '';\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    test_id: payload.test_id,\n    ai_output: String(aiOutput).slice(0, 500),\n    new_event_count: newEvents.length,\n    event_id: eventId,\n    event_title: title,\n    proposed_day: day,\n    proposed_start_iso: startISO,\n    proposed_end_iso: endISO,\n    response_time_ms: elapsedMs\n  }\n}];"
      },
