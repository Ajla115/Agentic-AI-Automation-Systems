    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json;\nconst testId = String(row.ID || '').trim();\nconst inputText = String(row.Input_Text || '').trim();\n\n// Extract the LAST TASK: ... SOLUTION: block\nlet task = '';\nconst re = /TASK:\\s*([\\s\\S]*?)\\s*SOLUTION:/g;\nlet m, last = null;\nwhile ((m = re.exec(inputText)) !== null) last = m[1];\ntask = last ? last.trim() : inputText;\n\nconst today = new Date();\nconst yyyy = today.getFullYear();\nconst mm = String(today.getMonth() + 1).padStart(2, '0');\nconst dd = String(today.getDate()).padStart(2, '0');\nconst weekdays = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nconst todayWeekday = weekdays[today.getDay()];\n\nfunction nextOccurrenceDate(weekday) {\n  const targetIdx = weekdays.indexOf(weekday);\n  if (targetIdx < 0) return null;\n  const todayIdx = today.getDay();\n  let daysUntil = (targetIdx - todayIdx + 7) % 7;\n  if (daysUntil === 0) daysUntil = 7; // 'Monday' on Monday → next Monday\n  const d = new Date(today);\n  d.setDate(d.getDate() + daysUntil);\n  const y = d.getFullYear();\n  const mn = String(d.getMonth() + 1).padStart(2, '0');\n  const dy = String(d.getDate()).padStart(2, '0');\n  return y + '-' + mn + '-' + dy;\n}\n\n// Substitute each weekday mention in the task with 'YYYY-MM-DD (Weekday)'\nlet taskWithDates = task;\nweekdays.forEach(function(wd) {\n  const wdRe = new RegExp('\\\\b' + wd + '\\\\b', 'g');\n  if (wdRe.test(taskWithDates)) {\n    const dateStr = nextOccurrenceDate(wd);\n    if (dateStr) {\n      taskWithDates = taskWithDates.replace(new RegExp('\\\\b' + wd + '\\\\b', 'g'), dateStr + ' (' + wd + ')');\n    }\n  }\n});\n\nconst prompt = '[TEST_MODE] (test_id=' + testId + ') ' +\n  'Today is ' + yyyy + '-' + mm + '-' + dd + ' (' + todayWeekday + '). The current year is ' + yyyy + '. ALL datetimes you create MUST use ' + yyyy + ' or later. NEVER use 2024 or any year from your training data.\\n\\n' +\n  'Please schedule the meeting described below. After picking a valid time, CREATE the event on my calendar with:\\n' +\n  '  - TITLE: \"TEST_' + testId + ': Meeting with <participant names>\" (extract participant names; keep TEST_' + testId + ' prefix exactly).\\n' +\n  '  - DESCRIPTION: short text with participants, requested duration, 1-line constraint summary per participant, and test_id ' + testId + '.\\n\\n' +\n  'Do not ask for confirmation — automated test.\\n\\n' +\n  'IMPORTANT: All weekday names in the task below have been pre-resolved to concrete future dates in ' + yyyy + '. Use those EXACT dates in your start_iso and end_iso parameters — do not change the year.\\n\\n' +\n  '=== SCHEDULING TASK ===\\n' + taskWithDates;\n\nreturn {\n  json: {\n    test_id: testId,\n    started_at: new Date().toISOString(),\n    message: { text: prompt, chat: { id: 'test_runner' } }\n  }\n};"
      },
