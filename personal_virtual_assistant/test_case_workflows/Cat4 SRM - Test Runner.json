    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json;\nconst testId = String(row.ID || '').trim();\nconst inputText = String(row.Input_Text || '').trim();\nconst metaRaw = String(row.Input_Metadata_JSON || '').trim();\nlet meta = {};\ntry { meta = JSON.parse(metaRaw); } catch(e) {}\nconst offset = Number(meta.reminder_offset_min || 0);\n\nlet task = '';\nconst re = /TASK:\\s*([\\s\\S]*?)\\s*SOLUTION:/g;\nlet m, last = null;\nwhile ((m = re.exec(inputText)) !== null) last = m[1];\ntask = last ? last.trim() : inputText.replace(/^Find a slot per:\\s*/i, '');\n\n// extract attendees + duration from the task\nlet attendees = [];\nlet durationMin = 30;\nconst durRe = /for\\s+(half an hour|one hour|an hour|\\d+\\s*hours?|\\d+\\s*minutes?)/i;\nconst dm = task.match(durRe);\nif (dm) {\n  const d = dm[1].toLowerCase();\n  if (d.includes('half')) durationMin = 30;\n  else if (d.includes('one hour') || d === 'an hour') durationMin = 60;\n  else { const num = parseInt(d, 10); if (d.includes('hour')) durationMin = num*60; else durationMin = num; }\n}\nconst attRe = /schedule a meeting for ([^\\.]+?) for/i;\nconst am = task.match(attRe);\nif (am) {\n  const namePart = am[1].replace(/ and /g, ', ');\n  attendees = namePart.split(',').map(s => s.trim()).filter(Boolean);\n}\n\nconst today = new Date();\nconst yyyy = today.getFullYear();\nconst mm = String(today.getMonth()+1).padStart(2,'0');\nconst dd = String(today.getDate()).padStart(2,'0');\nconst weekdays = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nconst todayWeekday = weekdays[today.getDay()];\n\nfunction nextOcc(wd) {\n  const t = weekdays.indexOf(wd);\n  if (t < 0) return null;\n  const days = (t - today.getDay() + 7) % 7;\n  const d = new Date(today); d.setDate(d.getDate()+days);\n  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');\n}\n\nlet taskWithDates = task;\nweekdays.forEach(wd => {\n  const wdRe = new RegExp('\\\\b'+wd+'\\\\b','g');\n  if (wdRe.test(taskWithDates)) {\n    const ds = nextOcc(wd);\n    if (ds) taskWithDates = taskWithDates.replace(wdRe, ds+' ('+wd+')');\n  }\n});\n\nconst prompt = '[TEST_MODE] (test_id=' + testId + ')\\n' +\n  'Today is '+yyyy+'-'+mm+'-'+dd+' ('+todayWeekday+'). Year='+yyyy+'. ALL datetimes MUST use '+yyyy+' or later.\\n\\n' +\n  '*** SKIP THE AVAILABILITY CHECK ***\\nDo NOT call GCal - Check Availability or GCal - List Events. The calendar may have overlapping TEST_ events from prior tests — that is intentional. Trust the constraints in the task and create events at slots YOU compute.\\n\\n' +\n  '*** CRITICAL: RESPECT EVERY CONSTRAINT STATED IN THE TASK ***\\nThe task text IS the source of truth for busy windows and rules. Before choosing a slot:\\n  (a) List every busy window stated in the task.\\n  (b) List every absolute restriction (\"X cannot meet on Monday\", \"avoid after 14:30\", etc.).\\n  (c) Pick a slot inside working hours violating none of (a) or (b). If multiple valid, pick earliest.\\n\\n' +\n  'Create TWO calendar events using GCal - Create Event:\\n\\n' +\n  '1. MAIN MEETING:\\n' +\n  '   - summary: \"TEST_' + testId + ': Meeting with ' + attendees.join(', ') + '\"\\n' +\n  '   - description: 2-3 lines (participants, ' + durationMin + ' minute duration, test_id ' + testId + ')\\n' +\n  '   - start_iso / end_iso: the slot you compute from constraints (duration ' + durationMin + ' min)\\n\\n' +\n  '2. REMINDER EVENT:\\n' +\n  '   - summary: \"TEST_' + testId + ': Reminder for meeting\"\\n' +\n  '   - description: \"Reminder for TEST_' + testId + ' main meeting (' + offset + ' minutes before).\"\\n' +\n  '   - start_iso: EXACTLY ' + offset + ' minutes BEFORE the main meeting start.\\n' +\n  '   - end_iso: start_iso + ' + durationMin + ' minutes (reminder has the SAME duration as the main meeting).\\n\\n' +\n  'Do not ask for confirmation — automated test mode.\\n\\n' +\n  'IMPORTANT: Weekday names have been pre-resolved to concrete '+yyyy+' dates. Use those EXACT dates.\\n\\n' +\n  '=== SCHEDULING TASK ===\\n' + taskWithDates;\n\nreturn { json: {\n  test_id: testId,\n  subcategory: String(row.Subcategory || ''),\n  channel: String(row.Channel || ''),\n  golden_plan: metaRaw,\n  reminder_offset_min: offset,\n  duration_min: durationMin,\n  attendees: attendees.join(', '),\n  started_at: new Date().toISOString(),\n  message: { text: prompt, chat: { id: 'test_runner_srm_'+testId } }\n}};"
      },
