      "parameters": {
        "jsCode": "const events = $input.all().map(i => i.json);\nconst ids = events.map(e => e.id).filter(Boolean);\nreturn [{ json: { cal_after_events: events, cal_after_ids: ids } }];"
      },
      "id": "agg-after",
      "name": "Aggregate Cal After",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2608,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "const agg = $input.first().json;\nconst payload = $('Collect Cal Before').first().json;\nconst calBefore = new Set(payload.calendar_before_ids || []);\nconst calAfter = agg.cal_after_events || [];\nconst newEvents = calAfter.filter(e => e.id && !calBefore.has(e.id));\nconst testId = payload.test_id;\nconst titlePrefix = 'TEST_' + testId;\nconst testEvents = newEvents.filter(e => (e.summary || '').includes(titlePrefix));\n\nlet mainEv = null, reminderEv = null;\nfor (const e of testEvents) {\n  const t = (e.summary || '').toLowerCase();\n  if (t.includes('reminder')) reminderEv = e; else mainEv = e;\n}\nif (testEvents.length === 2 && (!mainEv || !reminderEv)) {\n  const sorted = testEvents.slice().sort((a,b) => new Date(a.start.dateTime||a.start.date) - new Date(b.start.dateTime||b.start.date));\n  reminderEv = sorted[0]; mainEv = sorted[1];\n}\n\nconst mainStartISO = mainEv ? ((mainEv.start && (mainEv.start.dateTime || mainEv.start.date)) || '') : '';\nconst mainEndISO = mainEv ? ((mainEv.end && (mainEv.end.dateTime || mainEv.end.date)) || '') : '';\nconst remStartISO = reminderEv ? ((reminderEv.start && (reminderEv.start.dateTime || reminderEv.start.date)) || '') : '';\n\nlet reminderMinutesBefore = '';\nif (mainStartISO && remStartISO) {\n  reminderMinutesBefore = Math.round((new Date(mainStartISO) - new Date(remStartISO)) / 60000);\n}\nconst expectedOffset = payload.reminder_offset_min;\nconst reminderPass = (reminderMinutesBefore !== '' && reminderMinutesBefore === expectedOffset) ? 'Y' : 'N';\n\nlet day = '';\nif (mainStartISO) day = new Date(mainStartISO).toLocaleDateString('en-US', { weekday: 'long', timeZone: 'Europe/Sarajevo' });\n\nconst vaResp = $('Call Telegram VA').first()?.json || {};\nconst aiOutput = vaResp.ai_output || vaResp.output || '';\nconst startedAt = payload.started_at;\nconst elapsedMs = startedAt ? (Date.now() - new Date(startedAt).getTime()) : '';\n\nlet status = 'failed';\nif (mainEv && reminderEv) status = 'success';\nelse if (mainEv || reminderEv) status = 'partial';\n\nreturn [{ json: {\n  timestamp: new Date().toISOString(),\n  test_id: payload.test_id,\n  subcategory: payload.subcategory,\n  channel: payload.channel,\n  calendar_event_id: (mainEv && mainEv.id) || '',\n  calendar_event_title: (mainEv && mainEv.summary) || '',\n  calendar_event_description: (mainEv && mainEv.description) || '',\n  calendar_event_start_iso: mainStartISO,\n  calendar_event_end_iso: mainEndISO,\n  calendar_event_day: day,\n  draft_id: '',\n  draft_subject: '',\n  draft_to: '',\n  draft_message: '',\n  ai_output: String(aiOutput).slice(0, 800),\n  golden_plan: payload.golden_plan,\n  attendees: payload.attendees,\n  new_event_count: String(testEvents.length),\n  new_draft_count: '',\n  response_time_ms: String(elapsedMs),\n  status: status,\n  reminder_id: (reminderEv && reminderEv.id) || '',\n  reminder_minutes_before: reminderMinutesBefore === '' ? '' : String(reminderMinutesBefore),\n  reminder_pass: reminderPass\n}}];"
      },
