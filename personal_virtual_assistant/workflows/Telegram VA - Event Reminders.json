        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=⏰ *REMINDER — {{ $json.minutesUntil }} minutes!*\n\n📌 {{ $json.summary }}\n🕐 {{ $json.start.dateTime ? new Date($json.start.dateTime).toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'}) : 'All day' }}\n📍 {{ $json.location ?? 'No location' }}",
        "additionalFields": {
