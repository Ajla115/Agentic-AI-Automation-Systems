      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "YOUR_AI_EMAIL@example.com",
          "mode": "list",
          "cachedResultName": "YOUR_AI_EMAIL@example.com"
        },
        "returnAll": true,
        "timeMin": "={{ $now.toISO() }}",
        "timeMax": "={{ $now.plus({ hours: 1 }).toISO() }}",
        "options": {
          "orderBy": "startTime"
        }
      },
      "id": "tg-remind-gcal-001",
      "name": "Get Upcoming Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        752,
        464
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "vgDIWdn7j16Ol1sl",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst now = new Date();\nfor (const item of $input.all()) {\n  const startStr = item.json.start?.dateTime || item.json.start?.date;\n  if (!startStr) continue;\n  const eventStart = new Date(startStr);\n  const minutesUntil = Math.round((eventStart - now) / 60000);\n  if (minutesUntil >= 25 && minutesUntil <= 35) {\n    results.push({ json: { ...item.json, minutesUntil } });\n  }\n}\nreturn results;"
      },
      "id": "tg-remind-filter-001",
      "name": "Filter Events (25-35 min)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        464
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-0",
              "leftValue": "={{ $json.summary }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "tg-remind-if-001",
      "name": "Has Events?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1264,
        464
