    {
      "parameters": {
        "jsCode": "const escalations = $input.all().map(i => i.json);\nconst now = Date.now();\nconst SLA_THRESHOLD = 60 * 60 * 1000;\n\nconst overdue = escalations.filter(t => {\n  if (t.response !== 'Pending') return false;\n  const escalatedAt = new Date(t.timestampStart).getTime();\n  if (isNaN(escalatedAt)) return false;\n  return (now - escalatedAt) > SLA_THRESHOLD;\n}).map(t => ({\n  ...t,\n  hoursOverdue: ((now - new Date(t.timestampStart).getTime()) / 3600000).toFixed(1)\n}));\n\nconsole.log(`Found ${overdue.length} overdue escalations`);\nreturn overdue.map(r => ({ json: r }));"
      },
