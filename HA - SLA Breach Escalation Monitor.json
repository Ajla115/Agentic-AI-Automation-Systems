    {
      "parameters": {
        "jsCode": "const items = $('Merge Alert Count').all();\nconst total = items.length;\n\nconst maxOverdue = Math.max(...items.map(i => parseFloat(i.json.hoursOverdue) || 0));\nconst firstNotice = items.filter(i => i.json.newAlertCount === 1).length;\nconst secondPlus = items.filter(i => i.json.newAlertCount >= 2).length;\n\nconst top5 = items\n  .sort((a, b) => parseFloat(b.json.hoursOverdue) - parseFloat(a.json.hoursOverdue))\n  .slice(0, 5)\n  .map(i => {\n    const q = (i.json.query || '').substring(0, 50);\n    return `  \\u2022 ${i.json.messageId} \\u2014 ${i.json.hoursOverdue}h overdue (Alert #${i.json.newAlertCount})\\n    ${q}...`;\n  })\n  .join('\\n');\n\nconst summary = `<b>\\ud83d\\udea8 SLA BREACH SUMMARY \\ud83d\\udea8</b>\\n\\n` +\n  `<b>Total overdue:</b> ${total}\\n` +\n  `<b>Max overdue:</b> ${maxOverdue.toFixed(1)}h\\n` +\n  `<b>First notice:</b> ${firstNotice}\\n` +\n  `<b>Repeat notice (2+):</b> ${secondPlus}\\n\\n` +\n  `<b>Top 5 most overdue:</b>\\n${top5}\\n\\n` +\n  `<b>\\u26a0\\ufe0f All ${total} breaches logged to SLA_Breach_Logs sheet.</b>`;\n\nreturn [{ json: { summary } }];"
      },
