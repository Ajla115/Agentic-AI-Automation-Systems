    {
      "parameters": {
        "jsCode": "const lookupItems = $input.all();\nconst tickets = $('Filter Overdue Escalations').all();\n\nreturn tickets.map((ticket, i) => {\n  const t = ticket.json;\n  let alertCount = 0;\n  const lookup = lookupItems[i]?.json;\n  if (lookup && lookup.alertCount !== undefined && lookup.alertCount !== '') {\n    alertCount = parseInt(lookup.alertCount, 10) || 0;\n  }\n  return { json: { ...t, alertCount, newAlertCount: alertCount + 1 } };\n});"
      },
