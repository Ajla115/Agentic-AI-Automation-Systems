      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const timestampEnd = item.json.timestampEnd;\n  if (timestampEnd && timestampEnd !== '') {\n    console.log('Skipping already processed ticket: ' + item.json.messageId);\n    continue;\n  }\n  results.push(item);\n}\n\nconsole.log('Dedup: ' + items.length + ' in, ' + results.length + ' new (' + (items.length - results.length) + ' already processed)');\nreturn results;"
      },
