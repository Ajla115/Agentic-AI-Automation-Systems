    {
      "parameters": {
        "jsCode": "// Get all messages from Gmail\nconst messages = $input.all();\n\nconsole.log(\"Total messages received:\", messages.length);\n\n// If no messages, return empty\nif (messages.length === 0) {\n  console.log(\"No messages to process\");\n  return [];\n}\n\n// Calculate time threshold (15 minutes ago to be safe)\nconst now = Date.now();\nconst fiveMinutesAgo = now - (5 * 60 * 1000);\n\nconsole.log(\"Current time:\", new Date(now).toISOString());\nconsole.log(\"Threshold (5 min ago):\", new Date(fiveMinutesAgo).toISOString());\n\n// Function to extract only the newest email content (remove quotes)\nfunction extractLatestEmailContent(text) {\n  if (!text) return '';\n  const quotePatterns = [\n    /\\s*čet,.*?napisao je:\\s*/i,\n    /\\s*\\w+,\\s*\\d{1,2}\\.\\s*\\w+.*?napisao je:\\s*/i,\n    /\\s*On\\s+.*?\\d{4}.*?wrote:\\s*/i,\n    /\\s*<[^>]+>\\s*wrote:\\s*/i,\n    /\\s*napisao je:\\s*/i\n  ];\n  let cleanText = text;\n  for (const pattern of quotePatterns) {\n    const match = cleanText.match(pattern);\n    if (match) {\n      cleanText = cleanText.substring(0, match.index).trim();\n      break;\n    }\n  }\n  cleanText = cleanText.split('\\n').filter(line => !line.trim().startsWith('>')).join('\\n');\n  cleanText = cleanText.replace(/\\n{3,}/g, '\\n\\n').trim();\n  return cleanText;\n}\n\nfunction parseMessageDate(msg) {\n  const dateValue = msg.internalDate || msg.date || msg.receivedDateTime;\n  if (!dateValue) return Date.now();\n  if (typeof dateValue === 'number') return dateValue;\n  if (typeof dateValue === 'string') {\n    const parsed = parseInt(dateValue);\n    if (!isNaN(parsed)) return parsed;\n    const dateObj = new Date(dateValue);\n    if (!isNaN(dateObj.getTime())) return dateObj.getTime();\n  }\n  return Date.now();\n}\n\nconst recentMessages = [];\nmessages.forEach((item, index) => {\n  const msg = item.json;\n  const sentTime = parseMessageDate(msg);\n  if (sentTime > fiveMinutesAgo) {\n    const rawContent = msg.text || msg.snippet || '';\n    const cleanedContent = extractLatestEmailContent(rawContent);\n    recentMessages.push({\n      json: {\n        messageId: msg.id,\n        snippet: cleanedContent,\n        sentTime: sentTime,\n        sentTimeReadable: new Date(sentTime).toISOString()\n      }\n    });\n  }\n});\n\nconsole.log(\"Total recent messages:\", recentMessages.length);\nreturn recentMessages;"
      },
