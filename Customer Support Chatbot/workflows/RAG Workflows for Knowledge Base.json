        "jsCode": "// Current files in Google Drive\nconst driveFiles = $('Search files and folders').all()\n  .map(item => ({\n    fileId: item.json.id,\n    fileName: item.json.name\n  }));\n\n// Tracked files in Google Sheets\nconst trackedFiles = $('Read File Tracker Logs').all()\n  .map(item => item.json);\n\nconst driveFileIds = driveFiles.map(f => f.fileId);\n\nconst toDelete = [];\nconst toMarkMissing = [];\nconst toMarkActive = [];\n\ntrackedFiles.forEach(tracked => {\n  // Skip already deleted\n  if (tracked.status === 'deleted') return;\n\n  const stillInDrive = driveFileIds.includes(tracked.fileId);\n\n  if (!stillInDrive) {\n    if (tracked.status === 'missing_once') {\n      // Missing 2nd time → DELETE!\n      toDelete.push(tracked);\n    } else {\n      // Missing 1st time → just mark\n      toMarkMissing.push(tracked);\n    }\n  } else if (tracked.status === 'missing_once') {\n    // Was missing but came back\n    toMarkActive.push(tracked);\n  }\n});\n\nconsole.log('To Delete:', toDelete.length);\nconsole.log('To Mark Missing:', toMarkMissing.length);\nconsole.log('To Mark Active:', toMarkActive.length);\n\nreturn [{\n  json: {\n    toDelete,\n    toMarkMissing,\n    toMarkActive\n  }\n}];"
      },
