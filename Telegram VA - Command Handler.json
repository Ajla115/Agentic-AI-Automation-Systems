    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "🤖 *Virtual Assistant Commands:*\n\n📅 /schedule [event] — Add a new calendar event\n📋 /today — See today's events\n🔍 /check [date] — Check availability on a date\n✉️ /email [recipient] [topic] — Draft an email\n💬 Just type naturally — I understand plain language too!\n\n_Powered by N8N + GPT-4o_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
