        "jsCode": "const triggerData = $('Telegram Trigger').first().json;\nconst messageText = triggerData.message?.text || '';\nconst isCommand = messageText.startsWith('/');\n\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    trigger_type: isCommand ? 'command' : 'freeform',\n    command: isCommand ? messageText.split(' ')[0] : 'freeform_text',\n    action_completed: 'true',\n    response_time_ms: String(Date.now() - new Date($execution.startedAt).getTime()),\n    user_confirmed_before_action: 'pending'\n  }\n};"
      },
