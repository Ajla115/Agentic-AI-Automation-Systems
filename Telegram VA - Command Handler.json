      "id": "tg-cmd-gcal-001",
      "name": "Get Today's Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1072,
        464
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "vgDIWdn7j16Ol1sl",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst dateStr = now.toLocaleDateString('en-US', options);\n\nif (!items || items.length === 0 || !items[0].json.summary) {\n  return [{ json: { formatted_schedule: `📋 *Today's Schedule — ${dateStr}*\\n\\n✅ No events scheduled today. Enjoy your free day!` } }];\n}\n\nlet msg = `📋 *Today's Schedule — ${dateStr}*\\n\\n`;\n\nfor (const item of items) {\n  const e = item.json;\n  const startStr = e.start?.dateTime || e.start?.date;\n  let timeDisplay = 'All day';\n  if (e.start?.dateTime) {\n    timeDisplay = new Date(e.start.dateTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });\n  }\n  const location = e.location ? ` 📍 ${e.location}` : '';\n  msg += `🕐 ${timeDisplay} — *${e.summary}*${location}\\n`;\n}\n\nmsg += '\\n_Have a productive day!_';\n\nreturn [{ json: { formatted_schedule: msg } }];"
      },
