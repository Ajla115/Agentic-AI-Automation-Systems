    {
      "parameters": {
        "jsCode": "// Filter sent messages: keep only recent human-agent replies\n// (within the last 5 minutes), skip the automated 'Request Forwarded\n// to Support Team' confirmation that goes out on every escalation.\nconst items = $input.all();\nconsole.log('Messages in:', items.length);\n\nif (items.length === 0) return [];\n\nconst now = Date.now();\nconst fiveMinutesAgo = now - (5 * 60 * 1000);\nconst AUTO_REPLY_SNIPPET_PREFIX = 'Request Forwarded to Support Team';\n\nfunction stripQuotedReply(text) {\n  if (!text) return '';\n  const quotePatterns = [\n    /\\s*On\\s+.*?\\d{4}.*?wrote:\\s*/i,\n    /\\s*<[^>]+>\\s*wrote:\\s*/i,\n    /\\s*\\w+\\s+napisao je:\\s*/i\n  ];\n  let clean = text;\n  for (const p of quotePatterns) {\n    const m = clean.match(p);\n    if (m) { clean = clean.substring(0, m.index).trim(); break; }\n  }\n  clean = clean.split('\\n').filter(l => !l.trim().startsWith('>')).join('\\n');\n  return clean.replace(/\\n{3,}/g, '\\n\\n').trim();\n}\n\nconst out = [];\nfor (const item of items) {\n  const msg = item.json || {};\n\n  // Parse send time from Gmail's internalDate (ms-since-epoch as string).\n  if (!msg.internalDate) {\n    console.log('Skip (no internalDate):', msg.id);\n    continue;\n  }\n  const sentTime = parseInt(msg.internalDate, 10);\n  if (isNaN(sentTime) || sentTime <= fiveMinutesAgo) {\n    console.log('Skip (too old):', msg.id, sentTime);\n    continue;\n  }\n\n  const snippet = (msg.snippet || '').trim();\n\n  // Skip the system's automated 'Request Forwarded' confirmation.\n  if (snippet.startsWith(AUTO_REPLY_SNIPPET_PREFIX)) {\n    console.log('Skip (auto-reply):', msg.id);\n    continue;\n  }\n\n  if (!msg.id || !msg.threadId) {\n    console.log('Skip (missing id/threadId):', msg.id);\n    continue;\n  }\n\n  out.push({\n    json: {\n      messageId: msg.id,\n      threadId: msg.threadId,\n      subject: msg.Subject || msg.subject || '',\n      snippet: stripQuotedReply(snippet),\n      sentTime,\n      sentTimeReadable: new Date(sentTime).toISOString()\n    }\n  });\n}\n\nconsole.log('Human replies passing filter:', out.length);\nreturn out;"
      },
