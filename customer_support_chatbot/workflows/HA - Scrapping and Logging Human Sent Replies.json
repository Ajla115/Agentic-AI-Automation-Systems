    {
      "parameters": {
        "jsCode": "// Pass only rows that are still awaiting a human reply.\n// Interaction_Logs uses three states for timestampEnd:\n//   - real ISO timestamp  -> AI already responded, or human reply already logged\n//   - 'None' or empty     -> escalated ticket still waiting for the human agent\n//   - undefined/null      -> no matching row at all (lookup miss)\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const messageId = item.json.messageId;\n  const threadId = item.json.threadId;\n  const timestampEnd = item.json.timestampEnd;\n\n  // Lookup miss: no Interaction_Logs row for this thread.\n  if (!threadId && !messageId) {\n    console.log('Skip (no matching ticket row)');\n    continue;\n  }\n\n  // Already processed: real timestamp present and not the placeholder 'None'.\n  const alreadyDone =\n    timestampEnd &&\n    timestampEnd !== '' &&\n    timestampEnd !== 'None' &&\n    timestampEnd !== 'none';\n  if (alreadyDone) {\n    console.log('Skip (already processed):', messageId || threadId);\n    continue;\n  }\n\n  results.push(item);\n}\n\nconsole.log('Pending human-reply rows:', results.length, '/', items.length);\nreturn results;"
      },
      "id": "47ee04b1-6586-4674-b143-212e80b1e5cb",
      "name": "Skip Already Processed",
      "type": "n8n-nodes-base.code",
