      "parameters": {
        "jsCode": "const driveFiles = $('Search files and folders').all().map(item => ({fileId: item.json.id, fileName: item.json.name}));\nconst trackedFiles = $('Read File Tracker Logs').all().map(item => item.json);\nconst driveFileIds = driveFiles.map(f => f.fileId);\nconst toDelete = [];\nconst toMarkMissing = [];\nconst toMarkActive = [];\ntrackedFiles.forEach(tracked => {\n  if (tracked.status === 'deleted') return;\n  const stillInDrive = driveFileIds.includes(tracked.fileId);\n  if (!stillInDrive) {\n    if (tracked.status === 'missing_once') toDelete.push(tracked);\n    else toMarkMissing.push(tracked);\n  } else if (tracked.status === 'missing_once') {\n    toMarkActive.push(tracked);\n  }\n});\nreturn [{json: {toDelete, toMarkMissing, toMarkActive}}];"
      },
