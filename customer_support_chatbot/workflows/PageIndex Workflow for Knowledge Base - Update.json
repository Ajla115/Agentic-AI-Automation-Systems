    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst docs = Array.isArray(response) ? response : (response.documents || response.docs || response.data || []);\nconst trigger = $('Execute Workflow Trigger').first().json;\nconst fileName = trigger.fileName || '';\nconst baseName = fileName.replace(/\\.[^/.]+$/, '').toLowerCase();\nconst oldDoc = docs.find(d => {\n  const name = (d.name || d.doc_name || '').toLowerCase();\n  return baseName && name.includes(baseName);\n});\nreturn [{ json: { fileId: trigger.fileId, fileName, hasOldDoc: !!oldDoc, oldDocId: oldDoc ? (oldDoc.id || oldDoc.doc_id) : null } }];"
      },
      "id": "pi-upd-find",
      "name": "Find Old Doc By Name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "old-exists",
              "leftValue": "={{ $json.hasOldDoc }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
