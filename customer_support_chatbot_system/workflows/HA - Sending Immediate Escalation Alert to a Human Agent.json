        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n</head>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0; padding: 30px; background-color: #f5f5f5;\">  \n  <div style=\"background-color: #ffffff; padding: 35px; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.3);\">\n    \n    <div style=\"width: 48px; height: 4px; background-color: #4A90D9; border-radius: 2px; margin-bottom: 20px;\"></div>\n\n    <h2 style=\"color: #1B2A4A; margin-top: 0; margin-bottom: 20px; font-size: 20px;\">Request Forwarded to Support Team</h2>\n    \n    <p style=\"color: #555; line-height: 1.7; margin-bottom: 15px;\">\n      Hello,\n    </p>\n    \n    <p style=\"color: #555; line-height: 1.7; margin-bottom: 15px;\">\n      Your email has been forwarded to our customer support team for personalized assistance.\n    </p>\n    \n    <p style=\"color: #555; line-height: 1.7; margin-bottom: 20px;\">\n      A human agent will review your request and respond within <strong style=\"color: #1B2A4A;\">1 hour</strong>.\n    </p>\n    \n    <div style=\"background-color: #EBF3FC; padding: 16px 20px; border-left: 4px solid #4A90D9; border-radius: 0 8px 8px 0; margin: 24px 0;\">\n      <p style=\"color: #1B2A4A; margin: 0 0 4px 0; font-size: 0.95em; font-weight: bold;\">What happens next?</p>\n      <p style=\"color: #4A6080; margin: 0; font-size: 0.9em; line-height: 1.6;\">Our support team will contact you directly via email to resolve your issue.</p>\n    </div>\n    \n    <p style=\"color: #555; line-height: 1.6; margin-top: 25px; margin-bottom: 5px;\">\n      Best regards,\n    </p>\n    <p style=\"color: #1B2A4A; font-weight: bold; margin-top: 0;\">\n      Customer Support Team\n    </p>\n    \n  </div>\n  \n  <p style=\"color: #8899BB; font-size: 0.82em; text-align: center; margin-top: 20px;\">\n    This is an automated confirmation. Please do not reply to this email.\n  </p>\n  \n</body>\n</html>",
